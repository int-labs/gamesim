{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "types": ["node", "express", "jest"],
    "typeRoots": ["./types", "./node_modules/@types"]
  },
  "include": ["src/**/*", "types/**/*"],
  // `*.legacy.*` is parked reference code — untracked, not wired to anything,
  // and NOT required to compile. See src/sim/calcMarketModel.legacy.ts.
  "exclude": ["node_modules", "src/**/*.legacy.ts", "src/**/*.legacy.test.ts"]
}
