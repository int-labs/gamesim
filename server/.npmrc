# Render sets NODE_ENV=production for this service before running the build
# command (npm install; npm run build). Modern npm still honors the legacy
# "production" config being derived from NODE_ENV, which makes a plain
# `npm install` skip devDependencies — and typescript, @types/express, and
# @types/jest are ALL devDependencies here, so the build step (`tsc`) fails
# with TS2688 (missing type definitions) or "tsc: not found" depending on
# whether a stale global/cached tsc happens to be present.
#
# This forces devDependencies to install regardless of NODE_ENV, for the build
# step only — the running app never reads this file. Verified in a
# node:24-bullseye container with NODE_ENV=production: without this file,
# `npm install` adds 265 packages and `npm run build` fails; with it, 840
# packages install and `npm run build` produces dist/index.js.
production=false
