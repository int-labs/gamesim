# Gamesim environment variables
#
# Player (client/) — Vite
#   VITE_GAMESIM_API_URL   Base URL for the gamesim REST API (include /api)
#                          e.g. http://localhost:5000/api
#
# Server (server/)
#   PORT                   HTTP port (default 5000 locally, 3000 in Docker)
#   MONGO_URI              Mongo connection string
#   JWT_SECRET             Access-token signing secret
#   NODE_ENV               development | production
#
# Origins (HTTP CORS + Socket.IO share the same allowlist)
#   CLIENT_ORIGIN          Primary frontend origin (player in production)
#   PLAYER_ORIGIN          Optional explicit player origin
#   ADMIN_ORIGIN           Optional admin UI origin (separate deploy)
#   ALLOWED_ORIGINS        Comma-separated extra origins
#   RENDER_EXTERNAL_URL    Set automatically on Render
#
# Local defaults always include:
#   http://localhost:5173 / http://127.0.0.1:5173  (player Vite)
#   http://localhost:3001 / http://127.0.0.1:3001  (admin Vite)
#   http://localhost:3000 / http://localhost:3005
#
# Example local .env (server/):
#   PORT=5000
#   MONGO_URI=mongodb://127.0.0.1:27017/gamesim
#   JWT_SECRET=dev-secret
#   NODE_ENV=development
#   CLIENT_ORIGIN=http://127.0.0.1:5173
#   ADMIN_ORIGIN=http://localhost:3001
#
# Example local .env (client/):
#   VITE_GAMESIM_API_URL=http://localhost:5000/api
