{
  "name": "stratagem",
  "version": "1.0.0",
  "description": "Stratagem - Freelancer Management Platform",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:sim": "concurrently \"npm run dev:server\" \"npm run dev:notebook\"",
    "dev:notebook": "cd notebook-pixel-sim && npm run dev",
    "dev:notebook:alt": "cd notebook-pixel-sim && npm run dev -- --port 5174 --strictPort",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm start",
    "build": "npm run build:server && npm run build:client",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "test": "npm run test:server && npm run test:client",
    "test:server": "cd server && npm test",
    "test:client": "cd client && npm run test:e2e",
    "test:ci": "npm run test:server && npm run test:client:ci",
    "test:client:ci": "cd client && npm run test:e2e:ci",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install && cd ../notebook-pixel-sim && npm install",
    "start:ci": "concurrently \"npm run start:server:ci\" \"npm run start:client:ci\"",
    "start:server:ci": "cd server && PORT=5001 npm run dev",
    "start:client:ci": "cd client && npm start",
    "dev:player": "cd notebook-pixel-sim && npm run dev",
    "build:player": "cd notebook-pixel-sim && npm run build",
    "dev:client:alt": "cd client && npm start -- --port 3002 --strictPort",
    "lint": "npm run lint:server && npm run lint:client",
    "lint:server": "cd server && npm run lint",
    "lint:client": "cd client && npm run lint",
    "typecheck": "npm run typecheck:server && npm run typecheck:client && npm run typecheck:player",
    "typecheck:server": "cd server && npx tsc --noEmit",
    "typecheck:client": "cd client && npx tsc --noEmit",
    "typecheck:player": "cd notebook-pixel-sim && npx tsc -b"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "mongodb": "^6.19.0",
    "random-words": "^2.0.1",
    "supabase": "^2.107.0",
    "supabase-js": "^0.0.1-security"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
