{
  "spacing": {
    "$type": "dimension",
    "$description": "The spacing scale, used for padding, margin, gap, width, height, inset and line height. Figma Utilities/Spacing (Tailwind's 4 px scale). A key with '_' stands for a decimal point: 0_5 becomes the utility p-0.5. Values that are not on this scale do not exist as utilities.",
    "0": { "$value": "0px" },
    "px": { "$value": "1px" },
    "0_5": { "$value": "2px" },
    "1": { "$value": "4px" },
    "1_5": { "$value": "6px" },
    "2": { "$value": "8px" },
    "2_5": { "$value": "10px" },
    "3": { "$value": "12px" },
    "3_5": { "$value": "14px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "7": { "$value": "28px" },
    "8": { "$value": "32px" },
    "9": { "$value": "36px" },
    "10": { "$value": "40px" },
    "11": { "$value": "44px" },
    "12": { "$value": "48px" },
    "14": { "$value": "56px" },
    "16": { "$value": "64px" },
    "20": { "$value": "80px" },
    "24": { "$value": "96px" },
    "28": { "$value": "112px" },
    "32": { "$value": "128px" },
    "36": { "$value": "144px" },
    "40": { "$value": "160px" },
    "44": { "$value": "176px" },
    "48": { "$value": "192px" },
    "52": { "$value": "208px" },
    "56": { "$value": "224px" },
    "60": { "$value": "240px" },
    "64": { "$value": "256px" },
    "72": { "$value": "288px" },
    "80": { "$value": "320px" },
    "96": { "$value": "384px" }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Corner radii. Figma Utilities/Border Radius, renamed to Tailwind v4's names (Figma SM = xs, Default = sm, MD = md, LG = lg, XL = xl, 2XL = 2xl, 3XL = 3xl, Full = full). 4xl (32 px) is used by the final screens without a variable (login card, statement cards). Figma's 20 px (timer card) maps to 2xl.",
    "none": { "$value": "0px" },
    "xs": { "$value": "2px" },
    "sm": { "$value": "4px" },
    "md": { "$value": "6px" },
    "lg": { "$value": "8px" },
    "xl": { "$value": "12px" },
    "2xl": { "$value": "16px" },
    "3xl": { "$value": "24px" },
    "4xl": { "$value": "32px" },
    "full": { "$value": "9999px" }
  },
  "breakpoint": {
    "$type": "dimension",
    "$description": "Viewport breakpoints (min-width). Figma draws mobile at 440, tablet at 1024 and desktop at 1440 px.",
    "sm": { "$value": "640px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" },
    "2xl": { "$value": "1440px" },
    "3xl": { "$value": "1920px" }
  },
  "container": {
    "$type": "dimension",
    "$description": "Named maximum widths for layouts (max-w-* and container queries).",
    "xs": { "$value": "320px" },
    "sm": { "$value": "384px" },
    "md": { "$value": "448px" },
    "lg": { "$value": "512px" },
    "xl": { "$value": "576px" },
    "2xl": { "$value": "672px" },
    "3xl": { "$value": "768px" },
    "4xl": { "$value": "896px" },
    "5xl": { "$value": "1024px" },
    "6xl": { "$value": "1152px" },
    "7xl": { "$value": "1280px" }
  }
}
