{
  "name": "@stratagem/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "The Stratagem design system: tokens, fonts, icons, motion and components for the modular simulations and the Admin.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./icons": "./src/icons.ts",
    "./tokens": "./src/tokens/index.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "lockfile": "docker run --rm -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.63.0-noble npm install --package-lock-only --no-audit --no-fund",
    "typecheck": "tsc -b",
    "lint": "eslint . && stylelint \"src/**/*.css\" \".storybook/**/*.css\"",
    "test": "vitest run --project unit",
    "test:stories": "vitest run --project storybook",
    "test:watch": "vitest --project unit",
    "storybook": "storybook dev -p 6106 --no-open",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "test:visual": "playwright test",
    "test:visual:docker": "docker run --rm --ipc=host -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.63.0-noble npx playwright test",
    "test:visual:update": "docker run --rm --ipc=host -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.63.0-noble npx playwright test --update-snapshots",
    "check": "npm run generate:check && npm run typecheck && npm run lint && npm run test"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "tailwindcss": "^4.3.0"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@dicebear/core": "10.7.0",
    "@dicebear/styles": "10.6.0",
    "@fontsource-variable/noto-sans-thai": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@number-flow/react": "0.6.2",
    "@types/canvas-confetti": "1.9.0",
    "canvas-confetti": "1.9.4",
    "lucide-react": "1.47.0",
    "motion": "13.4.2",
    "react-day-picker": "10.0.1",
    "react-number-format": "5.4.4",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "eslint": "10.11.0",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.0",
    "fontaine": "1.0.0",
    "globals": "17.12.0",
    "jsdom": "26.1.0",
    "playwright": "1.63.0",
    "postcss": "8.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "storybook": "10.6.0",
    "style-dictionary": "5.5.5",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
