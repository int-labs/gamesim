# Production build values for the operator console (Vite loads this during
# `vite build`).
#
# NOT a secret store. Vite inlines every VITE_* variable into the client bundle,
# so anything put here is readable by every browser that loads the console.
# Public endpoints only; real secrets belong on the server.

# The gamesim API. The path really does end in /api — the server mounts every
# route under it (verified: /api/health returns 200, /health returns 404).
VITE_GAMESIM_API_URL=https://api.int-labs.site/api

# Where the PLAYER app is served from. Still unset, and it is not cosmetic:
# it backs the "Player Preview" link and it resolves the notebook art, which
# lives under the player's own public root and is addressed by convention
# (`/img/notebooks/<genreId>.png`). Left blank rather than guessed, because a
# wrong origin here shows broken covers on every product row in the console.
#
# Unset, it falls back to http://localhost:5173, which is dead in a deployment.
# Fill this in with the player's real origin before shipping the console:
# VITE_PLAYER_URL=https://<player-host>
