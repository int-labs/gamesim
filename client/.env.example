# The API the console talks to.
VITE_GAMESIM_API_URL=http://localhost:5000/api

# Where the player app is served from.
#
# Used for the Player Preview link AND to resolve the player's own art — the
# notebook covers live under the player's public root and are addressed by
# convention (`/img/notebooks/<genreId>.png`), so the console needs to know
# that origin to show them.
VITE_PLAYER_URL=http://localhost:5173
