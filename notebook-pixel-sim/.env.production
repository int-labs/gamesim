# Production build values for the player (Vite loads this during `vite build`).
#
# NOT a secret store. Vite inlines every VITE_* variable into the client bundle,
# so anything put here is readable by every browser that loads the game. Public
# endpoints only; real secrets belong on the server.

# The gamesim API. The path really does end in /api — the server mounts every
# route under it (verified: /api/health returns 200, /health returns 404).
VITE_GAMESIM_API_URL=https://api.int-labs.site/api

# HARD GUARD, not redundancy. `.env.local` on a developer machine carries
# VITE_SKIP_PASSKEY=1 to bypass the team login while working on UI, and Vite
# loads `.env.local` during a PRODUCTION build as well as a dev one. Without
# this line, a build made on that machine ships with the pass-key gate
# disabled — anyone with the URL walks straight into the game. `.env.[mode]`
# outranks `.env.local`, so setting it here is what actually closes it.
VITE_SKIP_PASSKEY=0
