# =============================================================================
# DOCKERFILE FOR RENDER.COM PREVIEW ENVIRONMENT (Player + Backend + MongoDB Atlas)
# File: Dockerfile.preview
# Admin is not bundled here — deploy via Dockerfile.admin separately.
# =============================================================================
FROM node:18-bullseye

# Install system dependencies and MongoDB client tools (for Atlas operations)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    wget \
    gnupg \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install MongoDB client tools using the official MongoDB installation script
RUN wget -qO - https://www.mongodb.org/static/pgp/server-6.0.asc | apt-key add - \
    && echo "deb [ arch=amd64,arm64 ] https://repo.mongodb.org/apt/debian bullseye/mongodb-org/6.0 main" | tee /etc/apt/sources.list.d/mongodb-org-6.0.list \
    && apt-get update && \
    apt-get install -y mongodb-mongosh \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# =============================================================================
# BUILD SHARED PACKAGES
# =============================================================================
COPY shared/finlit-engine/package*.json ./shared/finlit-engine/
COPY shared/api-contract/package*.json ./shared/api-contract/
RUN cd shared/finlit-engine && npm install && \
    cd ../api-contract && npm install

COPY shared/ ./shared/
RUN cd shared/finlit-engine && npm run build && \
    cd ../api-contract && npm run build

# =============================================================================
# BUILD PLAYER FRONTEND
# =============================================================================
COPY notebook-pixel-sim/package*.json ./notebook-pixel-sim/
RUN cd notebook-pixel-sim && npm ci && npm cache clean --force

COPY notebook-pixel-sim/ ./notebook-pixel-sim/
RUN cd notebook-pixel-sim && npm run build

# =============================================================================
# BUILD BACKEND
# =============================================================================
COPY server/package*.json ./server/
RUN cd server && npm ci --only=production && \
    npm install ts-node typescript @types/node && \
    npm cache clean --force

COPY server/ ./server/
RUN cd server && npm run build 2>/dev/null || echo "No build script found, skipping..."

# Move player build to server public folder (Vite outDir = dist)
RUN mkdir -p server/public && \
    (cp -r notebook-pixel-sim/dist/* server/public/ 2>/dev/null || cp -r notebook-pixel-sim/build/* server/public/ 2>/dev/null || echo "No player build found") && \
    chmod -R 755 server/public

# =============================================================================
# SETUP APPLICATION FOR RENDER.COM
# =============================================================================
WORKDIR /app/server

COPY start.sh /app/start.sh
COPY server/scripts/seed-data/ /app/server/scripts/seed-data/

RUN groupadd -r nodejs && useradd -m -r -g nodejs nodejs \
    && mkdir -p /home/nodejs \
    && chown -R nodejs:nodejs /home/nodejs /app \
    && chmod +x /app/start.sh

USER nodejs

EXPOSE ${PORT:-3000}

HEALTHCHECK --interval=30s --timeout=15s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:${PORT:-3000}/api/health 2>/dev/null || exit 1

CMD ["/app/start.sh"]
